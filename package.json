{
  "name": "hir-ensv2-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HIR ENSv2 invoice evidence contracts and independent verification",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "node scripts/invoice-record/validate.mjs",
    "test": "node --test test/invoice-record.test.mjs test/customer-invoice.test.mjs test/invoice-access.test.mjs test/customer-pdf.test.mjs test/sepolia-pdf-network.test.mjs test/customer-http.test.mjs",
    "app:start": "node app/customer/server.mjs",
    "app:build:ui": "tailwindcss -c app/customer/tailwind.config.cjs -i app/customer/stitch-input.css -o app/customer/public/stitch.css --minify",
    "test:browser": "node test/customer-browser.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.38",
    "viem": "2.57.13",
    "@fontsource/inter": "5.2.8",
    "fontkit": "2.0.4",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "hardhat": "3.21.1",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.17"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
