{
  "name": "hir-agents-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HIR Agents native ENS authority and attributable evidence foundation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "node src/compile.mjs",
    "test": "node --test test/ens.test.mjs test/evidence.test.mjs test/policy.test.mjs test/authority-reads.test.mjs test/registration.test.mjs test/wallet-connection.test.mjs test/ui.test.mjs test/wallet-recovery.test.mjs",
    "verify": "node src/verify-cli.mjs",
    "build": "node scripts/build-worker.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir build/dry-run",
    "test:worker": "node --test test/worker.test.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.38",
    "viem": "2.57.13",
    "@openai/agents": "0.21.0",
    "openai": "7.47.0",
    "zod": "4.6.7",
    "@openai/agents-core": "0.21.0",
    "@openai/agents-openai": "0.21.0"
  },
  "devDependencies": {
    "hardhat": "3.21.1",
    "wrangler": "4.158.0",
    "miniflare": "5.20261104.0-beta",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
