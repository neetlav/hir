{
  "name": "hir-agents",
  "main": "dist/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "keep_vars": true,
  "assets": {"directory":"dist/assets","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"},
  "vars": {"HIR_AGENTS_ORIGIN":"https://hir-agents.neetlav.workers.dev"},
  "durable_objects": {"bindings":[{"name":"AGENTS_STATE","class_name":"AgentsState"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["AgentsState"]}]
}
