{
 "name":"hir-invoice-test",
 "main":"worker-harness.mjs",
 "compatibility_date":"2026-11-06",
 "send_metrics":false,
 "define":{"import.meta.url":"\"file:///bundle/worker.mjs\""},
 "rules":[{"type":"Data","globs":["**/*.woff"],"fallthrough":true}],
 "assets":{"directory":"../dist/assets","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"},
 "durable_objects":{"bindings":[{"name":"INVOICE_STATE","class_name":"InvoiceState"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["InvoiceState"]}]
}
